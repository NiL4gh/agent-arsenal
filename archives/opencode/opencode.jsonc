{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "plan",
    "disabled_providers": [
        "opencode-go",
        "chatany"
    ],
    "experimental": {
        "batch_tool": true
    },
    "instructions": [
        "~/.remember/MEMORY.md"
    ],
    "agent": {
        "build": {
            "name": "build",
            "model": "nvidia/minimax-m3",
            "permission": "allow"
        },
        "plan": {
            "name": "plan",
            "model": "nvidia/glm-5.2",
            "permission": "allow"
        },
        "gentle-orchestrator": {
            "description": "Gentle orchestrator - routes to sub-agents, manages workflows",
            "mode": "subagent",
            "prompt": "You are a Gentle Orchestrator. Your role is to coordinate complex multi-step tasks by delegating to specialized sub-agents. You do NOT write code directly. Instead, you:\n1. Analyze the task and break it into logical phases\n2. Launch appropriate sub-agents for each phase (plan, build, review, etc.)\n3. Synthesize results and ensure coherence\n4. Report progress and final outcome\n\nAvailable sub-agents: plan, build, review, sdd-propose, sdd-spec, sdd-tasks, sdd-verify, jd-impl, jd-verify, git-worktree\n\nUse the task tool to launch sub-agents. Always specify the subagent_type and a clear prompt.",
            "tools": {
                "task": true,
                "read": true,
                "write": true,
                "edit": true,
                "bash": true,
                "glob": true,
                "grep": true
            }
        },
        "sdd-propose": {
            "description": "SDD Phase 1: Propose - explore problem space, generate proposals",
            "mode": "subagent",
            "prompt": "You are an SDD executor for the propose phase, not the orchestrator. Do this phase's work yourself. Do NOT delegate, Do NOT call task, and Do NOT launch sub-agents. Read your skill file at ~/.config/opencode/skills/sdd-propose/SKILL.md and follow it exactly.",
            "tools": {
                "bash": true,
                "edit": true,
                "read": true,
                "write": true
            }
        },
        "sdd-spec": {
            "description": "SDD Phase 2: Spec - write detailed specifications from proposals",
            "mode": "subagent",
            "prompt": "You are an SDD executor for the spec phase, not the orchestrator. Do this phase's work yourself. Do NOT delegate, Do NOT call task, and Do NOT launch sub-agents. Read your skill file at ~/.config/opencode/skills/sdd-spec/SKILL.md and follow it exactly.",
            "tools": {
                "bash": true,
                "edit": true,
                "read": true,
                "write": true
            }
        },
        "sdd-tasks": {
            "description": "SDD Phase 3: Tasks - break down specs into implementation tasks",
            "mode": "subagent",
            "prompt": "You are an SDD executor for the tasks phase, not the orchestrator. Do this phase's work yourself. Do NOT delegate, Do NOT call task, and Do NOT launch sub-agents. Read your skill file at ~/.config/opencode/skills/sdd-tasks/SKILL.md and follow it exactly.",
            "tools": {
                "bash": true,
                "edit": true,
                "read": true,
                "write": true
            }
        },
        "sdd-verify": {
            "description": "SDD Phase 4: Verify - validate implementation against specs",
            "mode": "subagent",
            "prompt": "You are an SDD executor for the verify phase, not the orchestrator. Do this phase's work yourself. Do NOT delegate, Do NOT call task, and Do NOT launch sub-agents. Read your skill file at ~/.config/opencode/skills/sdd-verify/SKILL.md and follow it exactly.",
            "tools": {
                "bash": true,
                "edit": true,
                "read": true,
                "write": true
            }
        },
        "jd-impl": {
            "description": "Job Description Implementation - implement features from JD specs",
            "mode": "subagent",
            "prompt": "You are a JD Implementation executor. Implement the feature described in the job description. Read your skill file at ~/.config/opencode/skills/jd-impl/SKILL.md and follow it exactly.",
            "tools": {
                "bash": true,
                "edit": true,
                "read": true,
                "write": true
            }
        },
        "jd-verify": {
            "description": "Job Description Verify - verify implementation matches JD",
            "mode": "subagent",
            "prompt": "You are a JD Verification executor. Verify the implementation matches the job description. Read your skill file at ~/.config/opencode/skills/jd-verify/SKILL.md and follow it exactly.",
            "tools": {
                "bash": true,
                "edit": true,
                "read": true,
                "write": true
            }
        },
        "review-code": {
            "description": "Code Review - review changes for quality, correctness, style",
            "mode": "subagent",
            "prompt": "You are a Code Reviewer. Review the changes for quality, correctness, and adherence to project standards. Be thorough but constructive.",
            "tools": {
                "bash": true,
                "read": true,
                "grep": true,
                "glob": true
            }
        },
        "git-worktree": {
            "description": "Git Worktree Manager - manage parallel work via worktrees",
            "mode": "subagent",
            "prompt": "You are a Git Worktree Manager. Create, manage, and clean up git worktrees for parallel development. Use git worktree commands.",
            "tools": {
                "bash": true,
                "read": true,
                "write": true
            }
        }
    },
    "mcp": {
        "context7": {
            "enabled": true,
            "type": "remote",
            "url": "https://mcp.context7.com/mcp"
        },
        "engram": {
            "command": [
                "engram.exe",
                "mcp",
                "--tools=agent"
            ],
            "enabled": true,
            "type": "local"
        },
        "figma": {
            "type": "local",
            "command": [
                "npx.cmd",
                "-y",
                "figma-developer-mcp",
                "--stdio"
            ],
            "environment": {
                "FIGMA_API_KEY": "<YOUR_FIGMA_API_KEY>",
                "IMAGE_DIR": "<YOUR_HOME>"
            },
            "enabled": false
        },
        "filesystem": {
            "type": "local",
            "command": [
                "npx.cmd",
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "<YOUR_HOME>"
            ],
            "enabled": true
        },
        "firecrawl": {
            "type": "local",
            "command": [
                "npx.cmd",
                "-y",
                "firecrawl-mcp"
            ],
            "environment": {
                "FIRECRAWL_API_KEY": "<YOUR_FIRECRAWL_API_KEY>"
            },
            "enabled": true
        },
        "github": {
            "type": "local",
            "command": [
                "npx.cmd",
                "-y",
                "@modelcontextprotocol/server-github"
            ],
            "environment": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": "<YOUR_GITHUB_PAT>"
            },
            "enabled": true
        },
        "illustrator": {
            "type": "local",
            "command": [
                "npx.cmd",
                "-y",
                "illustrator-mcp-server"
            ],
            "enabled": true
        },
        "sentry": {
            "type": "local",
            "command": [
                "npx.cmd",
                "-y",
                "@sentry/mcp-server"
            ],
            "environment": {
                "SENTRY_ACCESS_TOKEN": "<YOUR_SENTRY_TOKEN>",
                "SENTRY_ORG": "<YOUR_SENTRY_ORG>",
                "EMBEDDED_AGENT_PROVIDER": "openai",
                "OPENAI_API_KEY": "<YOUR_OPENAI_KEY>"
            },
            "enabled": false
        },
        "supabase": {
            "type": "remote",
            "url": "https://mcp.supabase.com/mcp?project_ref=<YOUR_SUPABASE_PROJECT_REF>",
            "enabled": true
        },
        "aidesigner": {
            "enabled": true,
            "type": "remote",
            "url": "https://api.aidesigner.ai/api/v1/mcp"
        }
    },
    "provider": {
        "nvidia": {
            "provider": "openai-compatible",
            "options": {
                "baseURL": "http://127.0.0.1:1340/v1",
                "apiKey": "<YOUR_NVIDIA_API_KEY>"
            }
        },
        "opencode-go": {
            "provider": "openai-compatible",
            "options": {
                "baseURL": "https://api.opencode.ai/go/v1",
                "apiKey": "<YOUR_OPENCODE_GO_KEY>"
            }
        },
        "chatany": {
            "name": "ChatAny",
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "https://api.chatanywhere.org"
            },
            "models": {
                "GPT-4o": {
                    "name": "GPT-4o"
                }
            }
        },
        "chatanywhere": {
            "provider": "openai-compatible",
            "options": {
                "baseURL": "https://api.chatanywhere.tech/v1",
                "apiKey": "<YOUR_CHATANYWHERE_KEY>"
            },
            "models": {
                "deepseek-v4-pro": {
                    "name": "deepseek-v4-pro",
                    "limit": {
                        "context": 131072,
                        "input": 120000,
                        "output": 4096
                    }
                },
                "deepseek-v4-flash": {
                    "name": "deepseek-v4-flash",
                    "limit": {
                        "context": 131072,
                        "input": 120000,
                        "output": 4096
                    }
                },
                "deepseek-r1": {
                    "name": "deepseek-r1",
                    "limit": {
                        "context": 131072,
                        "input": 120000,
                        "output": 4096
                    }
                },
                "gpt-4o-mini-ca": {
                    "name": "gpt-4o-mini-ca",
                    "limit": {
                        "context": 128000,
                        "input": 120000,
                        "output": 4096
                    }
                }
            }
        },
        "opencode": {
            "models": {
                "deepseek-v4-flash-free": {
                    "limit": {
                        "context": 131072,
                        "input": 120000,
                        "output": 4096
                    }
                },
                "hy3-free": {
                    "limit": {
                        "context": 131072,
                        "input": 120000,
                        "output": 4096
                    }
                },
                "mimo-v2.5-free": {
                    "limit": {
                        "context": 131072,
                        "input": 120000,
                        "output": 4096
                    }
                },
                "nemotron-3-ultra-free": {
                    "limit": {
                        "context": 131072,
                        "input": 120000,
                        "output": 4096
                    }
                },
                "north-mini-code-free": {
                    "limit": {
                        "context": 131072,
                        "input": 120000,
                        "output": 4096
                    }
                },
                "big-pickle": {
                    "limit": {
                        "context": 131072,
                        "input": 120000,
                        "output": 4096
                    }
                }
            }
        },
        "gitlawb": {
            "name": "gitlawb",
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "https://opengateway.gitlawb.com/v1/chat/completions"
            },
            "models": {
                "mimo-v2.5-pro": {
                    "name": "mimo-v2.5-pro"
                }
            }
        },
        "agentrouter": {
            "name": "AgentRouter",
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "http://127.0.0.1:8318/v1"
            },
            "models": {
                "claude-opus-4-6": {
                    "name": "claude-opus-4-6"
                },
                "claude-opus-4-7": {
                    "name": "claude-opus-4-7"
                },
                "gpt-5.5": {
                    "name": "gpt-5.5"
                }
            }
        },
        "openai": {
            "name": "OpenAI Compatible Custom",
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "https://dbc-f1dd5353-d33b.cloud.databricks.com/ai-gateway/mlflow/v1"
            },
            "models": {
                "system.ai.glm-5-2": {
                    "name": "GLM 5.2"
                }
            }
        }
    },
    "permission": {
        "bash": "allow",
        "edit": {
            "*": "allow"
        },
        "glob": {
            "*": "allow"
        },
        "grep": {
            "*": "allow"
        },
        "question": "allow",
        "read": {
            "*": "allow"
        },
        "task": {
            "*": "allow"
        },
        "write": {
            "*": "allow"
        }
    },
    "plugin": [
        "@tarquinen/opencode-dcp@latest",
        "browser-smoke"
    ]
}