{
  "plugins": {
    "android-cli-plugin": {
      "installedFrom": {
        "id": "antigravity-plugins-official/plugin/android-cli-plugin",
        "marketplace": "antigravity-plugins-official",
        "version": "1.0.16625370"
      }
    },
    "chrome-devtools-plugin": {
      "enabled": true
    },
    "modern-web-guidance-plugin": {
      "enabled": true
    },
    "superpowers": {
      "enabled": true
    },
    "swarm": {
      "enabled": true
    }
  },
  "sidecars": {
    "android-cli-plugin/compose-preview": {
      "schemaVersion": 1
    },
    "android-cli-plugin/device-hub": {
      "schemaVersion": 1
    },
    "swarm/swarm_board": {
      "schemaVersion": 1
    }
  },
  "userSettings": {
    "browserJsExecutionPolicy": "BROWSER_JS_EXECUTION_POLICY_ALWAYS_ASK",
    "globalPermissionGrants": {
      "allow": [
        "command(powershell)",
        "command(Get-NetTCPConnection)",
        "command(Stop-Process)",
        "command(Get-Content)",
        "command(Get-ChildItem)",
        "command(Invoke-WebRequest)",
        "command(git status)",
        "command(git remote)",
        "command(git branch)",
        "command(git add)",
        "command(git log)",
        "command(git diff)",
        "command(git commit)",
        "command(git stage)",
        "command(git show)",
        "command(npm run)",
        "mcp(chrome_devtools/*)",
        "command(Get-Command)",
        "command(&)",
        "command(Test-Path)",
        "command(Start-Process)",
        "command(Get-Process)",
        "command(Get-CimInstance)",
        "command(cmd.exe)",
        "command(Select-String)",
        "command(Copy-Item)",
        "command(Remove-Item)",
        "command(New-Item)",
        "command(huggingface-cli)",
        "command(conda)",
        "command(netstat)",
        "command(where)",
        "command(where.exe)",
        "command(git clone)",
        "read_url(github.com)",
        "read_url(raw.githubusercontent.com)"
      ]
    },
    "useAiCredits": true
  }
}
